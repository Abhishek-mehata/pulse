                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-43" edge="1" parent="1" source="r5ayQANOhl4-_n7Ag0gp-39" style="endArrow=none;dashed=1;html=1;rounded=1;entryX=0.125;entryY=0.625;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.938;exitY=0.644;exitDx=0;exitDy=0;exitPerimeter=0;" target="r5ayQANOhl4-_n7Ag0gp-40" value="">
                    <mxGeometry height="50" relative="1" width="50" as="geometry">
                        <Array as="points"/>
                        <mxPoint x="420" y="1770" as="sourcePoint"/>
                        <mxPoint x="730" y="1550" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-35" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;Chatting App&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Since User 1 and User 2 cannot communicate to each other directly.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;They need a Server medium Help. Suppose user 1 wants to send message to user 2. User 1 will make a message packet send to the server.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;User 2 will be requesting to server every second that &quot;Has any message arrived for me?&quot;.&lt;br&gt;Now, since packet is arrived at server, user 2 will be able to receive message and this goes on.&lt;br&gt;&lt;br&gt;If there is atleast 1000 users in server, it will require lots of resources, storage, internet bills and many more other things&lt;/font&gt;&lt;/p&gt;" vertex="1">
                    <mxGeometry height="360" width="350" x="260" y="1010" as="geometry"/>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;User 1&lt;/font&gt;" vertex="1">
                    <mxGeometry height="30" width="60" x="-10" y="1390" as="geometry"/>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;User 2&lt;/font&gt;" vertex="1">
                    <mxGeometry height="30" width="60" x="780" y="1380" as="geometry"/>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-46" edge="1" parent="1" source="r5ayQANOhl4-_n7Ag0gp-45" style="endArrow=classic;html=1;rounded=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;" target="r5ayQANOhl4-_n7Ag0gp-39" value="">
                    <mxGeometry height="50" relative="1" width="50" as="geometry">
                        <Array as="points">
                            <mxPoint x="510" y="1690"/>
                        </Array>
                        <mxPoint x="590" y="1540" as="sourcePoint"/>
                        <mxPoint x="540" y="1820" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-48" edge="1" parent="1" source="r5ayQANOhl4-_n7Ag0gp-45" style="endArrow=classic;html=1;rounded=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="r5ayQANOhl4-_n7Ag0gp-40" value="">
                    <mxGeometry height="50" relative="1" width="50" as="geometry">
                        <Array as="points">
                            <mxPoint x="870" y="1680"/>
                        </Array>
                        <mxPoint x="540" y="1834" as="sourcePoint"/>
                        <mxPoint x="870" y="1820" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-49" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;rounded=1;" value="">
                    <mxGeometry height="50" relative="1" width="50" as="geometry">
                        <mxPoint x="-130" y="1450" as="sourcePoint"/>
                        <mxPoint x="930" y="1440" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-51" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;rounded=1;" value="">
                    <mxGeometry height="50" relative="1" width="50" as="geometry">
                        <mxPoint x="-1000" y="2070" as="sourcePoint"/>
                        <mxPoint x="2480" y="2070" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-50" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;This is called Pooling.&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Pooling is a request-response cycle where every client in our case is requesting to server in every 1 second.&lt;br&gt;And as a developer point of view, this is very very overkill thing.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;If there are 1000 of clients are requesting at every repetation of 1 second, the load in server will increase very rapidly.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;In pooling after every second request is coming to server, even though the server is responding with empty response if no message packets is sent for the user.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Many request-response is getting wasted.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;This is increasing load unnecessarily.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Web Socket is the solution of this problem.&lt;/font&gt;&lt;/p&gt;" vertex="1">
                    <mxGeometry height="600" width="540" x="-30" y="1450" as="geometry"/>
                </mxCell>
                <mxCell id="r5ayQANOhl4-_n7Ag0gp-53" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 32px;&quot;&gt;Web Socket.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="30" width="820" x="20" y="2110" as="geometry"/>
                </mxCell>
                <mxCell id="8ixdqejY3-KzBfXecWcH-70" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 28px;&quot;&gt;Server&lt;/font&gt;" vertex="1">
                    <mxGeometry height="20" width="60" x="820" y="2270" as="geometry"/>
                </mxCell>
